<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dao.UserMapper">

    <resultMap id="userMap"
               type="com.example.demo.model.User">

        <id property="userid" column="userid"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="account" column="account"/>
        <result property="password" column="password"/>

    </resultMap>

    <select id="findAll"
            statementType="CALLABLE"
            resultMap="userMap">

        { CALL sp_get_all_users() }

    </select>
    
    <select id="findAccountsByUserid"
        statementType="CALLABLE"
        resultType="java.lang.String">
        
	    { CALL sp_get_user_accounts(
	        #{userid, mode=IN, jdbcType=VARCHAR}
	    ) }
	    
	</select>
	
	<select id="findByEmail"
        statementType="CALLABLE"
        resultMap="userMap">

	    { CALL sp_get_user_by_email(
	        #{email, mode=IN, jdbcType=VARCHAR}
	    ) }
	
	</select>
	
	<insert id="register" statementType="CALLABLE">
	    { CALL sp_register_user(
	        #{userid, mode=IN, jdbcType=VARCHAR},
	        #{username, mode=IN, jdbcType=VARCHAR},
	        #{email, mode=IN, jdbcType=VARCHAR},
	        #{password, mode=IN, jdbcType=VARCHAR},
	        #{account, mode=IN, jdbcType=VARCHAR}
	    ) }
	</insert>

</mapper>