<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dao.LikeListMapper">

    <resultMap id="likeListResponseMap"
               type="com.example.demo.dto.LikeListResponse">

        <id property="sn" column="sn"/>

        <result property="userid" column="userid"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="account" column="account"/>

        <result property="no" column="no"/>
        <result property="productName" column="product_name"/>
        <result property="price" column="price"/>
        <result property="feeRate" column="fee_rate"/>

        <result property="purchaseQuantity" column="purchase_quantity"/>
        <result property="productAmount" column="product_amount"/>
        <result property="totalFee" column="total_fee"/>
        <result property="totalAmount" column="total_amount"/>

    </resultMap>

    <select id="findAll"
            statementType="CALLABLE"
            resultMap="likeListResponseMap">

        { CALL sp_get_all_like_list() }

    </select>

    <insert id="insert"
            statementType="CALLABLE"
            parameterType="com.example.demo.model.LikeList">

        { CALL sp_add_like_list(
            #{account, mode=IN, jdbcType=VARCHAR},
            #{no, mode=IN, jdbcType=INTEGER},
            #{purchaseQuantity, mode=IN, jdbcType=INTEGER}
        ) }

    </insert>
    
    <delete id="delete" statementType="CALLABLE">
	    { CALL sp_delete_like_list(
	        #{sn, mode=IN, jdbcType=INTEGER}
	    ) }
	</delete>
	
	<update id="update"
        statementType="CALLABLE"
        parameterType="com.example.demo.model.LikeList">
	    { CALL sp_update_like_list(
	        #{sn, mode=IN, jdbcType=INTEGER},
	        #{account, mode=IN, jdbcType=VARCHAR},
	        #{no, mode=IN, jdbcType=INTEGER},
	        #{purchaseQuantity, mode=IN, jdbcType=INTEGER}
	    ) }
	
	</update>
	
	<select id="findByUserid"
        statementType="CALLABLE"
        resultMap="likeListResponseMap">

	    { CALL sp_get_user_like_list(
	        #{userid, mode=IN, jdbcType=VARCHAR}
	    ) }
	
	</select>
	
	<select id="checkAccountOwner"
        statementType="CALLABLE"
        resultType="java.lang.Integer">
	    { CALL sp_check_account_owner(
	        #{userid, mode=IN, jdbcType=VARCHAR},
	        #{account, mode=IN, jdbcType=VARCHAR}
	    ) }
	</select>
	
	<select id="checkLikeListOwner"
	        statementType="CALLABLE"
	        resultType="java.lang.Integer">
	    { CALL sp_check_like_list_owner(
	        #{userid, mode=IN, jdbcType=VARCHAR},
	        #{sn, mode=IN, jdbcType=INTEGER}
	    ) }
	</select>

</mapper>